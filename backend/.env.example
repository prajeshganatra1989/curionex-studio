# Application
APP_NAME=Curionex Studio API
APP_VERSION=0.1.0
ENVIRONMENT=development

# Database (PostgreSQL via psycopg 3)
# Replace username/password with your local credentials. Never commit a real .env.
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/curionex_studio

# Authentication (required for login / JWT)
# Generate a long random value for local use. Never commit real secrets.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Project codes (optional — defaults shown)
PROJECT_CODE_PREFIX=CRX
PROJECT_CODE_PAD_WIDTH=4

# Browser CORS origins (comma-separated). Empty disables CORS middleware.
# Never combine wildcard (*) with credentialed cookie auth.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI credential encryption (Fernet). Required to store provider API keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CREDENTIALS_KEY=